# ==============================================================================
# LLM Provider Configuration (.env)
# ==============================================================================
# The pipeline uses a single OpenAI-compatible abstraction in src/llm.py.
# If OPENAI_API_KEY is left empty, the pipeline automatically runs in
# deterministic offline mode with zero network requests and zero cost.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Standard OpenAI (Default)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
JUDGE_MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Alternative Provider Examples (Uncomment to use)
# ------------------------------------------------------------------------------

# Example: Groq (Ultra-fast inference)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# JUDGE_MODEL_NAME=llama-3.3-70b-versatile

# Example: Together AI
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.together.xyz/v1
# MODEL_NAME=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# JUDGE_MODEL_NAME=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# Example: DeepSeek
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat
# JUDGE_MODEL_NAME=deepseek-chat

# Example: Local Ollama (100% Free, Local Self-Hosted)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1
# JUDGE_MODEL_NAME=llama3.1

# Example: OpenRouter (Multi-model aggregator)
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=anthropic/claude-3.5-sonnet
# JUDGE_MODEL_NAME=openai/gpt-4o-mini
